# Copy to .env (gitignored) and fill in.

# Optional pokemontcg.io API key (https://dev.pokemontcg.io/). Raises the rate limit from the unauthenticated
# default to 20,000 requests/day. Only the server sees it; it's never sent to the browser.
POKEMON_TCG_API_KEY=

# Comma-separated origins allowed to call the API from a browser (CORS). Defaults to the GitHub Pages site and the
# Vite dev server.
# ALLOWED_ORIGINS=https://lucy-dot-exe.github.io,http://localhost:5173
